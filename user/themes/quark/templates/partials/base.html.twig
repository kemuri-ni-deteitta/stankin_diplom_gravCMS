{% block bottom %}
    {{ assets.js('bottom')|raw }}
    <script>
    (function() {
        function adjustPadding() {
            var isSmall = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
            document.body.style.paddingTop = isSmall ? '60px' : '80px';
        }
        adjustPadding();
        window.addEventListener('resize', adjustPadding);
    })();
    </script>
    
    <script>
    // ===== MODERN IMAGE ANIMATIONS ON SCROLL =====
    (function() {
        'use strict';
        
        // Check if user prefers reduced motion
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
            // Skip animations if user prefers reduced motion
            document.querySelectorAll('.portfolio-item, .portfolio-image, .gallery-item, .lightbox-gallery__column, .portfolio-card').forEach(function(el) {
                el.style.opacity = '1';
                el.style.transform = 'none';
            });
            return;
        }
        
        // Intersection Observer for scroll animations
        const observerOptions = {
            root: null,
            rootMargin: '0px 0px -50px 0px', // Trigger when element is 50px from viewport bottom
            threshold: 0.1
        };
        
        const animateOnScroll = function(entries, observer) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animated');
                    // Stop observing once animated
                    observer.unobserve(entry.target);
                }
            });
        };
        
        const observer = new IntersectionObserver(animateOnScroll, observerOptions);
        
        // Observe all elements that should animate
        function initAnimations() {
            const elementsToAnimate = document.querySelectorAll(
                '.portfolio-item, .portfolio-image, .gallery-item, .lightbox-gallery__column, .portfolio-card, .animate-on-scroll'
            );

            const hasStandGrid = !!document.querySelector('.portfolio-grid .portfolio-item');
            
            elementsToAnimate.forEach(function(element, index) {
                // Add staggered delay classes
                const delayClass = 'delay-' + ((index % 6) + 1);
                const isStandElement = hasStandGrid && element.closest('.portfolio-grid .portfolio-item');
                if (isStandElement) {
                    element.classList.remove('animate-on-scroll', 'animated', 'delay-1', 'delay-2', 'delay-3', 'delay-4', 'delay-5', 'delay-6');
                    element.style.opacity = '1';
                    element.style.transform = 'none';
                    return;
                } else if (!element.classList.contains('delay-1') && 
                           !element.classList.contains('delay-2') && 
                           !element.classList.contains('delay-3') &&
                           !element.classList.contains('delay-4') &&
                           !element.classList.contains('delay-5') &&
                           !element.classList.contains('delay-6')) {
                    element.classList.add('animate-on-scroll', delayClass);
                }
                observer.observe(element);
            });
        }
        
        // Initialize on DOM ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAnimations);
        } else {
            initAnimations();
        }
        
        // Re-initialize for dynamically loaded content (e.g., AJAX)
        const mutationObserver = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.addedNodes.length) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) { // Element node
                            const newElements = node.querySelectorAll ? 
                                node.querySelectorAll('.portfolio-item, .portfolio-image, .gallery-item, .lightbox-gallery__column, .portfolio-card') : [];
                            newElements.forEach(function(element) {
                                observer.observe(element);
                            });
                            // Also check if the node itself should be observed
                            if (node.matches && node.matches('.portfolio-item, .portfolio-image, .gallery-item, .lightbox-gallery__column, .portfolio-card')) {
                                observer.observe(node);
                            }
                        }
                    });
                }
            });
        });
        
        // Start observing the document body for changes
        mutationObserver.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        // Lazy loading image fade-in
        function handleLazyImages() {
            const lazyImages = document.querySelectorAll('img[loading="lazy"]');
            
            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            img.classList.add('loaded');
                            imageObserver.unobserve(img);
                        }
                    });
                });
                
                lazyImages.forEach(function(img) {
                    imageObserver.observe(img);
                });
            } else {
                // Fallback for browsers without IntersectionObserver
                lazyImages.forEach(function(img) {
                    img.classList.add('loaded');
                });
            }
        }
        
        // Initialize lazy image loading
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', handleLazyImages);
        } else {
            handleLazyImages();
        }
        
        // Navbar scroll effect - CSS handles background via .is-scrolled class
        let lastScroll = 0;
        const header = document.getElementById('custom-header');
        
        function handleNavbarScroll() {
            const currentScroll = window.pageYOffset || document.documentElement.scrollTop;
            
            if (header) {
                // CSS handles background via .is-scrolled class, no inline styles needed
                // Just toggle the class for scroll state
                header.classList.toggle('is-scrolled', currentScroll > 8);
            }
            
            lastScroll = currentScroll;
        }
        
        // Throttle scroll events for better performance
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    handleNavbarScroll();
                    ticking = false;
                });
                ticking = true;
            }
        });
        
        // Initial check
        handleNavbarScroll();
    })();
    </script>
{% endblock %}

