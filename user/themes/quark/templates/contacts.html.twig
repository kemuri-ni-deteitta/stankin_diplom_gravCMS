{% extends 'partials/base.html.twig' %}

{% block content %}
    {{ page.content|raw }}
    
    {% if page.header.phones or page.header.address or page.header.emails or page.header.social_networks %}
    <div class="contact-info-section">
        <h2>Контактная информация</h2>
        
        {% if page.header.address %}
        <div class="contact-item">
            <h3>Адрес</h3>
            <p><strong>{{ page.header.address }}</strong></p>
        </div>
        {% endif %}
        
        {% if page.header.phones %}
        <div class="contact-item">
            <h3>Телефоны</h3>
            <ul class="phone-list">
                {% for phone in page.header.phones %}
                <li>
                    <strong>{{ phone.number }}</strong>
                    {% if phone.description %}
                    <span class="phone-description"> - {{ phone.description }}</span>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
        {% if page.header.emails %}
        <div class="contact-item">
            <h3>Электронная почта</h3>
            <ul class="email-list">
                {% for email in page.header.emails %}
                <li>
                    <a href="mailto:{{ email.email }}"><strong>{{ email.email }}</strong></a>
                    {% if email.description %}
                    <span class="email-description"> - {{ email.description }}</span>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
        {% if page.header.social_networks %}
        <div class="contact-item">
            <h3>Социальные сети</h3>
            <ul class="social-list">
                {% for social in page.header.social_networks %}
                <li>
                    <a href="{{ social.username }}" target="_blank" rel="noopener">
                        <strong>
                            {% if social.platform == 'telegram' %}Telegram
                            {% elseif social.platform == 'whatsapp' %}WhatsApp
                            {% elseif social.platform == 'vk' %}ВКонтакте
                            {% elseif social.platform == 'instagram' %}Instagram
                            {% elseif social.platform == 'facebook' %}Facebook
                            {% elseif social.platform == 'twitter' %}Twitter/X
                            {% elseif social.platform == 'youtube' %}YouTube
                            {% elseif social.platform == 'linkedin' %}LinkedIn
                            {% else %}{{ social.platform|title }}{% endif %}
                        </strong>
                    </a>
                    {% if social.description %}
                    <span class="social-description"> - {{ social.description }}</span>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
    {% endif %}
    
    {# Yandex Map section - using reliable widget approach #}
    {% if page.header.address %}
    <div class="map-section">
        <h2>Как нас найти</h2>
        {% set yandex_api_key = page.header.yandex_api_key ?? config.site.yandex_api_key ?? '' %}
        <div class="map-card">
            <div id="yandex-map"
                 class="map-embed"
                 data-coordinates="{{ page.header.coordinates }}"
                 data-address="{{ page.header.address }}"
                 data-zoom="{{ page.header.map_zoom ?? 16 }}"
                 data-api-key="{{ yandex_api_key }}">
                <div class="map-placeholder">
                    <div class="map-placeholder-icon">🗺️</div>
                    <div class="map-placeholder-title"><strong>Загрузка карты...</strong></div>
                    <div class="map-placeholder-subtitle">{{ page.header.address }}</div>
                </div>
            </div>
        </div>
        
        <script type="text/javascript">
        (function() {
            var mapContainer = document.getElementById('yandex-map');
            if (!mapContainer) return;

            var coordsRaw = (mapContainer.dataset.coordinates || '').split(',');
            var lat = parseFloat((coordsRaw[0] || '').trim());
            var lng = parseFloat((coordsRaw[1] || '').trim());
            if (!isFinite(lat) || !isFinite(lng)) return;

            var address = mapContainer.dataset.address || '';
            var zoom = parseInt(mapContainer.dataset.zoom || '16', 10);
            var apiKey = mapContainer.dataset.apiKey || '';

            function initYandexMap() {
                if (!window.ymaps || typeof ymaps.ready !== 'function') return;

                ymaps.ready(function() {
                    var mapType = 'yandex#map';
                    try {
                        var darkLayerUrl = 'https://core-renderer-tiles.maps.yandex.net/tiles?l=map&theme=dark&x=%x&y=%y&z=%z&scale=1&lang=ru_RU';
                        ymaps.layer.storage.add('custom#dark', function() {
                            return new ymaps.Layer(darkLayerUrl);
                        });
                        ymaps.mapType.storage.add('custom#dark', new ymaps.MapType('Dark', ['custom#dark']));
                        mapType = 'custom#dark';
                    } catch (e) {
                        mapType = 'yandex#map';
                    }

                    var map = new ymaps.Map('yandex-map', {
                        center: [lat, lng],
                        zoom: zoom,
                        type: mapType,
                        controls: []
                    }, {
                        suppressMapOpenBlock: true,
                        suppressObsoleteBrowserNotifier: true
                    });

                    map.controls.add('zoomControl', { position: { right: 12, top: 12 } });
                    map.controls.add('fullscreenControl', { position: { left: 12, top: 12 } });

                    var marker = new ymaps.Placemark([lat, lng], null, {
                        preset: 'islands#circleIcon',
                        iconColor: '#4da3ff'
                    });

                    map.geoObjects.add(marker);
                    map.behaviors.disable('scrollZoom');

                    mapContainer.classList.add('is-loaded');
                    var placeholder = mapContainer.querySelector('.map-placeholder');
                    if (placeholder) {
                        placeholder.remove();
                    }
                });
            }

            function loadYandexApi() {
                if (window.ymaps) {
                    initYandexMap();
                    return;
                }
                var script = document.createElement('script');
                script.src = 'https://api-maps.yandex.ru/2.1/?lang=ru_RU' + (apiKey ? '&apikey=' + encodeURIComponent(apiKey) : '');
                script.async = true;
                script.onload = initYandexMap;
                document.head.appendChild(script);
            }

            loadYandexApi();
        })();
        </script>
    </div>
    {% endif %}
{% endblock %} 