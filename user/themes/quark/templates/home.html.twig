{% extends 'partials/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% do assets.addCss('https://vjs.zencdn.net/8.10.0/video-js.css') %}
{% endblock %}

{% block bottom %}
    {{ parent() }}
    <script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>
    <script>
    (function() {
        function formatTime(seconds) {
            if (!isFinite(seconds)) return '0:00';
            var m = Math.floor(seconds / 60);
            var s = Math.floor(seconds % 60);
            return m + ':' + (s < 10 ? '0' + s : s);
        }

        window._applyReelsTheaterDimensions = function(card) {
            if (!card || !card.classList.contains('reels-theater')) return;
            var vp = window.visualViewport;
            var w = (vp && vp.width) ? vp.width : window.innerWidth;
            var h = (vp && vp.height) ? vp.height : window.innerHeight;
            var px = 'px';
            card.style.width = w + px;
            card.style.height = h + px;
            card.style.minWidth = w + px;
            card.style.minHeight = h + px;
            card.style.maxWidth = w + px;
            card.style.maxHeight = h + px;
            var media = card.querySelector('.reels-media');
            if (media) {
                media.style.width = w + px;
                media.style.height = h + px;
                var playerEl = media.querySelector('.reels-player');
                var video = media.querySelector('video');
                if (playerEl) {
                    playerEl.style.width = '100%';
                    playerEl.style.height = '100%';
                    playerEl.style.maxWidth = w + px;
                    playerEl.style.maxHeight = h + px;
                }
                if (video) {
                    video.style.objectFit = 'contain';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    video.style.maxWidth = w + px;
                    video.style.maxHeight = h + px;
                    if (video._vjs && video._vjs.trigger) video._vjs.trigger('resize');
                }
                var vjsTech = media.querySelector('.vjs-tech');
                if (vjsTech) {
                    vjsTech.style.objectFit = 'contain';
                    vjsTech.style.width = '100%';
                    vjsTech.style.height = '100%';
                }
            }
        };

        function initReelPlayer(container) {
            var video = container.querySelector('.js-reel-video');
            var playBtn = container.querySelector('.reels-play');
            var overlayPlay = container.querySelector('.reels-overlay-play');
            var progress = container.querySelector('.reels-progress');
            var progressFill = container.querySelector('.reels-progress-fill');
            var progressThumb = container.querySelector('.reels-progress-thumb');
            var timeEl = container.querySelector('.reels-time');
            var volumeWrap = container.querySelector('.reels-volume');
            var volumeBtn = container.querySelector('.reels-volume-btn');
            var volumeRange = container.querySelector('.reels-volume input[type="range"]');
            var fullscreenBtn = container.querySelector('.reels-fullscreen');
            var reelCard = container.closest('.reels-card');
            var seekStep = 5;
            var inactivityTimer = null;
            var idleDelay = 2000;

            if (!video) return;

            if (typeof videojs !== 'function') {
                return;
            }

            if (!video._vjs) {
                video._vjs = videojs(video, {
                    controls: false,
                    fluid: true,
                    autoplay: false,
                    preload: 'metadata',
                    playsinline: true
                });
            }

            var player = video._vjs;

            function updatePlayState() {
                container.classList.toggle('is-playing', !player.paused());
                container.classList.toggle('is-paused', player.paused());
            }

            function updateTime() {
                var duration = player.duration() || 0;
                var current = player.currentTime() || 0;
                timeEl.textContent = formatTime(current) + ' / ' + formatTime(duration);
                if (duration > 0) {
                    var percent = (current / duration * 100);
                    progressFill.style.width = percent + '%';
                    if (progressThumb) {
                        progressThumb.style.left = percent + '%';
                    }
                }
            }

            function togglePlay() {
                if (player.paused()) {
                    player.play().catch(function() {});
                } else {
                    player.pause();
                }
            }

            var dragging = false;
            function seekToClientX(clientX) {
                var rect = progress.getBoundingClientRect();
                var ratio = (clientX - rect.left) / rect.width;
                ratio = Math.max(0, Math.min(1, ratio));
                var duration = player.duration();
                if (isFinite(duration) && duration > 0) {
                    player.currentTime(ratio * duration);
                }
            }

            function onPointerMove(e) {
                if (!dragging) return;
                seekToClientX(e.clientX);
            }

            function markActive() {
                if (inactivityTimer) {
                    clearTimeout(inactivityTimer);
                }
                container.classList.remove('is-idle');
                if (player.paused()) return;
                inactivityTimer = setTimeout(function () {
                    container.classList.add('is-idle');
                }, idleDelay);
            }

            playBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                togglePlay();
            });
            overlayPlay.addEventListener('click', function(e) {
                e.stopPropagation();
                togglePlay();
            });
            container.addEventListener('click', function(e) {
                if (e.target && e.target.closest('.reels-controls')) {
                    return;
                }
                if (e.target && e.target.closest('.reels-overlay-play')) {
                    return;
                }
                if (e.target && e.target.closest('.reels-volume-slider')) {
                    return;
                }
                togglePlay();
            });
            player.on('play', updatePlayState);
            player.on('pause', updatePlayState);
            player.on('ended', updatePlayState);
            player.on('timeupdate', updateTime);
            player.on('loadedmetadata', updateTime);

            progress.addEventListener('pointerdown', function(e) {
                dragging = true;
                progress.setPointerCapture(e.pointerId);
                seekToClientX(e.clientX);
                e.preventDefault();
            });
            progress.addEventListener('pointermove', onPointerMove);
            progress.addEventListener('pointerup', function(e) {
                dragging = false;
                progress.releasePointerCapture(e.pointerId);
            });
            progress.addEventListener('pointercancel', function(e) {
                dragging = false;
                progress.releasePointerCapture(e.pointerId);
            });

            var volumeRAF = null;
            var volumeTween = null;
            var currentVolume = parseFloat(volumeRange.value) || 0.4;
            var lastVolume = currentVolume > 0 ? currentVolume : 1;

            var audioReady = false;
            function ensureAudioGraph() {
                if (video._audioCtx && video._gainNode) {
                    audioReady = true;
                    return true;
                }
                var AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return false;
                try {
                    video._audioCtx = video._audioCtx || new AudioCtx();
                    if (!video._audioSource) {
                        video._audioSource = video._audioCtx.createMediaElementSource(video);
                        video._gainNode = video._audioCtx.createGain();
                        video._audioSource.connect(video._gainNode).connect(video._audioCtx.destination);
                    }
                    if (video._audioCtx.state === 'suspended') {
                        video._audioCtx.resume();
                    }
                    audioReady = true;
                    return true;
                } catch (e) {
                    return false;
                }
            }

            function setVolume(value, smooth) {
                currentVolume = Math.max(0, Math.min(1, value));
                if (audioReady) {
                    if (player.volume() !== 1) {
                        player.volume(1);
                    }
                    if (smooth) {
                        video._gainNode.gain.setTargetAtTime(currentVolume, video._audioCtx.currentTime, 0.03);
                    } else {
                        video._gainNode.gain.value = currentVolume;
                    }
                } else {
                    player.volume(currentVolume);
                }
                container.classList.toggle('is-muted', currentVolume === 0);
            }

            function smoothVolumeTo(target) {
                var start = currentVolume;
                var end = Math.max(0, Math.min(1, target));
                var duration = 120;
                var startTime = performance.now();

                if (volumeTween) {
                    cancelAnimationFrame(volumeTween);
                }

                function step(now) {
                    var t = Math.min(1, (now - startTime) / duration);
                    var eased = t * (2 - t);
                    setVolume(start + (end - start) * eased, false);
                    if (t < 1) {
                        volumeTween = requestAnimationFrame(step);
                    }
                }

                volumeTween = requestAnimationFrame(step);
            }

            volumeRange.addEventListener('input', function() {
                var value = parseFloat(volumeRange.value);
                if (volumeRAF) {
                    cancelAnimationFrame(volumeRAF);
                }
                volumeRAF = requestAnimationFrame(function() {
                    smoothVolumeTo(value);
                });
            });

            volumeRange.addEventListener('change', function() {
                smoothVolumeTo(parseFloat(volumeRange.value));
            });

            volumeBtn.addEventListener('click', function() {
                if (currentVolume === 0) {
                    setVolume(lastVolume || 1, true);
                } else {
                    lastVolume = currentVolume;
                    setVolume(0, true);
                }
            });

            function openTheater(card) {
                if (!card || card.classList.contains('reels-theater')) return;
                var placeholder = document.createElement('div');
                placeholder.setAttribute('data-reel-placeholder', '');
                placeholder.style.display = 'none';
                if (card.parentNode) {
                    card.parentNode.insertBefore(placeholder, card.nextSibling);
                }
                card._reelPlaceholder = placeholder;
                document.body.classList.add('reels-theater-open');
                document.body.appendChild(card);
                card.classList.add('reels-theater');
                if (window._applyReelsTheaterDimensions) window._applyReelsTheaterDimensions(card);
            }

            function closeTheater(card) {
                if (!card || !card.classList.contains('reels-theater')) return;
                card.classList.remove('reels-theater');
                document.body.classList.remove('reels-theater-open');
                /* Сбрасываем инлайн-стили, чтобы карточка не оставалась растянутой после выхода из theater */
                card.style.width = card.style.height = '';
                card.style.minWidth = card.style.minHeight = '';
                card.style.maxWidth = card.style.maxHeight = '';
                var media = card.querySelector('.reels-media');
                if (media) {
                    media.style.width = media.style.height = '';
                    var player = media.querySelector('.reels-player');
                    var video = media.querySelector('video');
                    if (player) {
                        player.style.width = player.style.height = '';
                        player.style.maxWidth = player.style.maxHeight = '';
                    }
                    if (video) {
                        video.style.objectFit = video.style.width = video.style.height = '';
                        video.style.maxWidth = video.style.maxHeight = '';
                    }
                    var vjsTech = media.querySelector('.vjs-tech');
                    if (vjsTech) {
                        vjsTech.style.objectFit = vjsTech.style.width = vjsTech.style.height = '';
                    }
                }
                var placeholder = card._reelPlaceholder;
                if (placeholder && placeholder.parentNode) {
                    placeholder.parentNode.insertBefore(card, placeholder);
                    placeholder.parentNode.removeChild(placeholder);
                }
                card._reelPlaceholder = null;
            }

            fullscreenBtn.addEventListener('click', function() {
                if (!reelCard) return;
                var isTheater = reelCard.classList.contains('reels-theater');
                if (isTheater) {
                    closeTheater(reelCard);
                } else {
                    document.querySelectorAll('.reels-card.reels-theater').forEach(function(card) {
                        closeTheater(card);
                    });
                    openTheater(reelCard);
                }
            });

            if (reelCard) {
                var backdrop = reelCard.querySelector('.reels-theater-backdrop');
                if (backdrop) {
                    backdrop.addEventListener('click', function() {
                        closeTheater(reelCard);
                    });
                }
                var reelMedia = reelCard.querySelector('.reels-media');
                if (reelMedia) {
                    reelMedia.addEventListener('click', function(e) {
                        if (e.target === reelMedia) {
                            closeTheater(reelCard);
                        }
                    });
                }
            }

            function seekBy(delta) {
                var duration = player.duration();
                if (!isFinite(duration) || duration <= 0) return;
                var next = Math.max(0, Math.min(duration, player.currentTime() + delta));
                player.currentTime(next);
            }

            container.addEventListener('pointerdown', function() {
                window._lastReelPlayer = container;
            });

            document.addEventListener('keydown', function(e) {
                var key = e.key;
                if (key !== 'ArrowLeft' && key !== 'ArrowRight' && key !== ' ' && key !== 'Escape' && key !== 'ArrowUp' && key !== 'ArrowDown') return;
                var target = e.target;
                if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
                    return;
                }
                var active = document.querySelector('.reels-card.reels-theater [data-reel-player]') || window._lastReelPlayer;
                if (!active || active !== container) return;
                e.preventDefault();
                if (key === 'Escape') {
                    if (reelCard && reelCard.classList.contains('reels-theater')) {
                        closeTheater(reelCard);
                    }
                } else if (key === ' ') {
                    togglePlay();
                } else if (key === 'ArrowUp' || key === 'ArrowDown') {
                    var step = 0.05;
                    var nextVolume = currentVolume + (key === 'ArrowUp' ? step : -step);
                    nextVolume = Math.max(0, Math.min(1, nextVolume));
                    volumeRange.value = nextVolume.toFixed(2);
                    smoothVolumeTo(nextVolume);
                } else {
                    seekBy(key === 'ArrowRight' ? seekStep : -seekStep);
                }
            });

            player.one('play', function() {
                if (ensureAudioGraph()) {
                    setVolume(currentVolume, false);
                }
            });
            setVolume(currentVolume, false);
            updatePlayState();
            updateTime();

            ['mousemove', 'touchstart', 'pointermove'].forEach(function(eventName) {
                container.addEventListener(eventName, markActive);
            });
            markActive();
        }

        function initReels() {
            document.querySelectorAll('[data-reel-player]').forEach(initReelPlayer);
            if (window._reelsTheaterResizeBound) return;
            window._reelsTheaterResizeBound = true;
            function onTheaterResize() {
                if (!document.body.classList.contains('reels-theater-open')) return;
                var card = document.querySelector('.reels-card.reels-theater');
                if (card && window._applyReelsTheaterDimensions) {
                    setTimeout(function() {
                        requestAnimationFrame(function() {
                            window._applyReelsTheaterDimensions(card);
                        });
                    }, 150);
                }
            }
            window.addEventListener('orientationchange', onTheaterResize);
            window.addEventListener('resize', onTheaterResize);
            if (window.visualViewport) window.visualViewport.addEventListener('resize', onTheaterResize);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReels);
        } else {
            initReels();
        }
    })();
    </script>
{% endblock %}

{% macro render_home_slider(slider, page) %}
    {% set slider_items = slider.items ?? [] %}
    {% set has_bulk = slider.bulk_upload is defined and slider.bulk_upload|length > 0 %}
    {% set has_items = slider_items|length > 0 %}
    {% if has_bulk or has_items %}
            <section class="home-slider home-slider--fullbleed swiper home-swiper" data-home-slider
                     data-autoplay="{{ slider.autoplay is defined and slider.autoplay ? 'true' : 'false' }}"
                     data-interval="{{ slider.interval ?? 3500 }}"
                     data-loop="{{ slider.loop is defined and slider.loop ? 'true' : 'false' }}"
                     data-per-view="5"
                     data-per-view-md="3"
                     data-per-view-sm="1.2"
                     data-gap="{{ slider.gap ?? 18 }}">
                {# Slider background panel (separate rectangle behind the slider) #}
                <div class="home-slider-panel" aria-hidden="true"></div>
                {% if slider.title %}
                    <h2 class="home-slider-title">{{ slider.title }}</h2>
                {% endif %}
                {% if slider.description %}
                    <p class="home-slider-description">{{ slider.description }}</p>
                {% endif %}
                {% set slide_entries = [] %}
                {% set slide_urls = [] %}

                {% if slider.bulk_upload %}
                    {% for filepath, filedata in slider.bulk_upload %}
                    {% set file_name = '' %}
                    {% set file_path = '' %}
                    {% if filedata.name is defined and filedata.name %}
                        {% set file_name = filedata.name %}
                    {% endif %}
                    {% if filedata.path is defined and filedata.path %}
                        {% set file_path = filedata.path %}
                    {% elseif filepath %}
                        {% set file_path = filepath %}
                    {% endif %}
                    {% if not file_name and file_path %}
                        {% set file_name = file_path|split('/')|last %}
                    {% endif %}
                    {% set media = file_name ? page.media[file_name] : null %}
                    {% set url = media ? media.url : (file_path ? base_url_absolute ~ '/' ~ file_path : '') %}
                    {% if url and url not in slide_urls %}
                        {% set slide_urls = slide_urls|merge([url]) %}
                                {% set slide_entries = slide_entries|merge([{
                            url: url,
                                    media: media,
                                    alt: '',
                                    link: ''
                                }]) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% for item in slider_items %}
                    {% set slide_images = [] %}
                    {% if item.image_upload %}
                        {% for filepath, filedata in item.image_upload %}
                            {% if filedata.name %}
                                {% set media = page.media[filedata.name] %}
                                {% if media %}
                                    {% set slide_images = slide_images|merge([media.url]) %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if slide_images|length == 0 %}
                        {% set image_key = item.image ?? '' %}
                        {% if image_key %}
                            {% set is_external = image_key starts with 'http' %}
                            {% set media_key = is_external ? '' : image_key|split('/')|last %}
                            {% set media = media_key ? page.media[media_key] : null %}
                            {% set image_url = media ? media.url : image_key %}
                            {% if image_url %}
                                {% set slide_images = [image_url] %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                    {% if slide_images|length > 0 %}
                        {% set alt_text = item.alt ?? item.title ?? '' %}
                        {% for image_url in slide_images %}
                            {% if image_url not in slide_urls %}
                                {% set slide_urls = slide_urls|merge([image_url]) %}
                                {% set slide_entries = slide_entries|merge([{
                                    url: image_url,
                                    media: media ?? null,
                                    alt: alt_text,
                                    link: item.link ?? ''
                                }]) %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% set preload_urls = [] %}
                {% for preload in slide_entries|slice(0, 3) %}
                    {% set preload_urls = preload_urls|merge([preload.url]) %}
                {% endfor %}

                <div class="home-slider-inner" data-preload="{{ preload_urls|json_encode|e('html_attr') }}">
                    <button class="home-slider-arrow home-slider-prev swiper-button-prev" type="button" aria-label="Предыдущий слайд" data-slider-prev>
                        <span class="home-slider-arrow-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>
                    </button>
                    <div class="home-slider-viewport" data-slider-viewport>
                        <div class="home-slider-track swiper-wrapper" data-slider-track>
                            {% for slide in slide_entries %}
                                {% set is_visible = loop.index0 < 5 %}
                                {% set is_priority = loop.index0 < 3 %}
                                <div class="home-slider-slide swiper-slide">
                                    {% if slide.link %}
                                        <a class="home-slider-card" href="{{ slide.link }}">
                                            {% if slide.media is defined and slide.media %}
                                                <img class="home-slider-image"
                                                     src="{{ slide.media.resize(350).url }}"
                                                     srcset="{{ slide.media.resize(350).url }} 350w, {{ slide.media.resize(700).url }} 700w"
                                                     sizes="(max-width: 640px) 80vw, (max-width: 960px) 30vw, 20vw"
                                                     alt="{{ slide.alt|e }}"
                                                     loading="{{ is_visible ? 'eager' : 'lazy' }}"
                                                     decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% else %}
                                                <img class="home-slider-image" src="{{ slide.url }}" alt="{{ slide.alt|e }}" loading="{{ is_visible ? 'eager' : 'lazy' }}" decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% endif %}
                                        </a>
                                    {% else %}
                                        <div class="home-slider-card">
                                            {% if slide.media is defined and slide.media %}
                                                <img class="home-slider-image"
                                                     src="{{ slide.media.resize(350).url }}"
                                                     srcset="{{ slide.media.resize(350).url }} 350w, {{ slide.media.resize(700).url }} 700w"
                                                     sizes="(max-width: 640px) 80vw, (max-width: 960px) 30vw, 20vw"
                                                     alt="{{ slide.alt|e }}"
                                                     loading="{{ is_visible ? 'eager' : 'lazy' }}"
                                                     decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% else %}
                                                <img class="home-slider-image" src="{{ slide.url }}" alt="{{ slide.alt|e }}" loading="{{ is_visible ? 'eager' : 'lazy' }}" decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <button class="home-slider-arrow home-slider-next swiper-button-next" type="button" aria-label="Следующий слайд" data-slider-next>
                        <span class="home-slider-arrow-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                    </button>
                </div>
            </section>
    {% endif %}
{% endmacro %}

{% import _self as home %}

{% block content %}
    {% set home_blocks = page.header.home_blocks ?? [] %}
    {% set has_slider = false %}

    {{ page.content|raw }}

    {% if home_blocks|length %}
        <section class="home-feature-list">
            {% for block in home_blocks %}
                {% set has_slider_media = block.slider_bulk_upload is defined and block.slider_bulk_upload|length > 0 %}
                {% set block_type = block.block_type ?? (has_slider_media ? 'slider' : 'content') %}
                {% if block_type != 'slider' %}
                    {% set block_title = block.title ?? '' %}
                    {% set block_text = block.text ?? '' %}
                    {% set media_type = block.media_type ?? 'image' %}
                    {% set media_position = block.media_position ?? (loop.index is odd ? 'right' : 'left') %}
                    {% set image_media = null %}
                    {% if media_type == 'image' and block.image %}
                        {% for filepath, filedata in block.image %}
                            {% if filedata.name %}
                                {% set image_media = page.media[filedata.name] %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                        {% set video_media = null %}
                        {% set poster = null %}
                        {% set poster_url = null %}
                    {% set video_url = block.video_url ?? '' %}
                    {% set video_embed = block.video_embed ?? '' %}
                    {% if media_type == 'video' and block.video_upload %}
                        {% for filepath, filedata in block.video_upload %}
                            {% if filedata.name %}
                                {% set video_media = page.media[filedata.name] %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                        {% if media_type == 'video' and block.poster_upload %}
                            {% for filepath, filedata in block.poster_upload %}
                                {% if not poster_url and filedata.path and (filedata.path starts with 'user/') %}
                                    {% set poster_url = base_url_absolute ~ '/' ~ filedata.path %}
                                {% endif %}
                                {% if not poster and filedata.name %}
                                    {% set poster = page.media[filedata.name] %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% set block_has_text = block_title or block_text %}
                    {% set block_has_media = (media_type == 'image' and image_media) or (media_type == 'video' and (video_media or video_url or video_embed)) %}
                    <div class="home-feature-block{% if media_position == 'left' %} is-media-left{% endif %}{% if not block_has_text %} is-media-only{% endif %}">
                        {% if block_has_text %}
                            <div class="home-feature-content">
                                {% if block_title %}
                                    <h1>{{ block_title }}</h1>
                                {% endif %}
                                {% if block_text %}
                                    <div class="home-feature-text">
                                        {{ block_text|markdown|raw }}
                </div>
            {% endif %}
                        </div>
                    {% endif %}
                        {% if block_has_media %}
                            <div class="home-feature-media">
                                {% if media_type == 'image' and image_media %}
                                    <img src="{{ image_media.resize(900).url }}"
                                         srcset="{{ image_media.resize(900).url }} 900w, {{ image_media.resize(1400).url }} 1400w"
                                 sizes="(max-width: 960px) 90vw, 45vw"
                                 alt=""
                                 loading="lazy"
                                 decoding="async">
                                {% elseif media_type == 'video' %}
                                    {% set orientation = block.video_orientation ?? 'vertical' %}
                                    <div class="reels-card reels-card--{{ orientation|e('html_attr') }} home-reels-card" data-reel>
                                        <div class="reels-theater-backdrop"></div>
                                        <div class="reels-media">
                                            {% if video_embed %}
                                                <iframe
                                                    src="{{ video_embed }}"
                                                    title="{{ block_title|e('html_attr') }}"
                                                    frameborder="0"
                                                    allow="autoplay; encrypted-media; picture-in-picture"
                                                    allowfullscreen>
                                                </iframe>
                                            {% else %}
                                                {% set video_src = video_media ? video_media.url(true) : video_url %}
                                                {% if video_src %}
                                                    <div class="reels-player" data-reel-player>
                                                        <video
                                                            class="video-js vjs-default-skin reels-video js-reel-video"
                                                            preload="metadata"
                                                            playsinline
                                                            src="{{ video_src }}"
                                                            {% if poster_url %}poster="{{ poster_url }}"{% elseif poster %}poster="{{ poster.url }}"{% endif %}>
                                                            <source src="{{ video_src }}" />
                                                            Ваш браузер не поддерживает воспроизведение этого видео.
                                                        </video>
                                                        <button class="reels-overlay-play" type="button" aria-label="Play">
                                                            <span class="reels-icon reels-icon-play"></span>
                                                            <span class="reels-icon reels-icon-pause"></span>
                                                        </button>
                                                        <div class="reels-controls">
                                                            <button class="reels-btn reels-play" type="button" aria-label="Play/Pause">
                                                                <span class="reels-icon reels-icon-play"></span>
                                                                <span class="reels-icon reels-icon-pause"></span>
                                                            </button>
                                                            <div class="reels-time">0:00 / 0:00</div>
                                                            <div class="reels-progress" role="slider" aria-label="Seek">
                                                                <div class="reels-progress-fill"></div>
                                                                <div class="reels-progress-thumb"></div>
                                                            </div>
                                                            <div class="reels-controls-right">
                                                                <div class="reels-volume">
                                                                    <button class="reels-btn reels-volume-btn" type="button" aria-label="Mute/Unmute">
                                                                        <span class="reels-icon reels-icon-volume"></span>
                                                                        <span class="reels-icon reels-icon-mute"></span>
                                                                    </button>
                                                                    <div class="reels-volume-slider">
                                                                        <input type="range" min="0" max="1" step="0.01" value="0.4" aria-label="Volume" />
                                                                    </div>
                                                                </div>
                                                                <button class="reels-btn reels-fullscreen" type="button" aria-label="Theater mode">
                                                                    <span class="reels-icon reels-icon-fullscreen"></span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="reels-placeholder">Видео не указано</div>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
                    </div>
            {% endif %}
                {% if has_slider_media %}
                    {% set slider_block = {
                        title: block.slider_title ?? '',
                        description: block.slider_description ?? '',
                        autoplay: block.slider_autoplay ?? true,
                        interval: block.slider_interval ?? 3500,
                        loop: block.slider_loop ?? true,
                        gap: block.slider_gap ?? 18,
                        bulk_upload: block.slider_bulk_upload ?? []
                    } %}
                    {{ home.render_home_slider(slider_block, page) }}
                    {% set has_slider = true %}
        {% endif %}
            {% endfor %}
        </section>
    {% endif %}

    {% if has_slider %}
        <script>
            (function () {
                if (window.Swiper) {
                    var swiperRoots = document.querySelectorAll('.home-swiper');
                    if (!swiperRoots.length) return;
                    swiperRoots.forEach(function (swiperRoot) {
                    var preloadData = swiperRoot.querySelector('.home-slider-inner')?.dataset?.preload;
                    if (preloadData) {
                        try {
                            JSON.parse(preloadData).forEach(function (url) {
                                var img = new Image();
                                img.src = url;
                            });
                        } catch (e) {}
                    }
                    var styles = getComputedStyle(swiperRoot);
                    var gap = parseFloat(styles.getPropertyValue('--card-gap')) || 0;
                    var perView = parseFloat(styles.getPropertyValue('--slides-per-view')) || 5;
                    var autoplayEnabled = swiperRoot.dataset.autoplay === 'true';
                    var autoplayInterval = parseInt(swiperRoot.dataset.interval || '3500', 10);
                    var loopEnabled = swiperRoot.dataset.loop === 'true';

                    new Swiper(swiperRoot, {
                        slidesPerView: perView,
                        spaceBetween: gap,
                        loop: loopEnabled,
                        speed: 380,
                        watchOverflow: true,
                        allowTouchMove: false,
                        navigation: {
                            nextEl: swiperRoot.querySelector('.swiper-button-next'),
                            prevEl: swiperRoot.querySelector('.swiper-button-prev')
                        },
                        autoplay: autoplayEnabled ? {
                            delay: autoplayInterval,
                            disableOnInteraction: false
                        } : false,
                        breakpoints: {
                            0: { slidesPerView: 1.2, spaceBetween: gap },
                            641: { slidesPerView: 3, spaceBetween: gap },
                            961: { slidesPerView: perView, spaceBetween: gap }
                        }
                        });
                    });
                    return;
                }

                var sliders = document.querySelectorAll('[data-home-slider]');
                if (!sliders.length) return;

                sliders.forEach(function (slider) {
                    var viewport = slider.querySelector('[data-slider-viewport]');
                    var track = slider.querySelector('[data-slider-track]');
                    var prevBtn = slider.querySelector('[data-slider-prev]');
                    var nextBtn = slider.querySelector('[data-slider-next]');
                    if (!viewport || !track) return;

                    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    var autoplayEnabled = slider.dataset.autoplay === 'true' && !reduceMotion;
                    var autoplayInterval = parseInt(slider.dataset.interval || '3500', 10);
                    var loopEnabled = slider.dataset.loop === 'true';
                    var gapValue = parseFloat(slider.dataset.gap || '18');

                    var state = {
                        perView: 1,
                        index: 0,
                        slideSize: 0,
                        visibleCount: 1,
                        cloneCount: 0,
                        originalCount: 0,
                        isDragging: false,
                        startX: 0,
                        startTranslate: 0,
                        autoplayTimer: null,
                        loopActive: false,
                        currentTranslate: 0
                    };

                    function getPerView() {
                        var width = window.innerWidth;
                        var perViewSm = parseFloat(slider.dataset.perViewSm || '1');
                        var perViewMd = parseFloat(slider.dataset.perViewMd || '2');
                        var perViewLg = parseFloat(slider.dataset.perView || '3');
                        if (width <= 640) return perViewSm;
                        if (width <= 960) return perViewMd;
                        return perViewLg;
                    }

                    function setCssVars() {
                        slider.style.setProperty('--slides-per-view', state.perView);
                        slider.style.setProperty('--slide-gap', gapValue + 'px');
                    }

                    function getTotalSlides() {
                        return track.children.length;
                    }

                    function cleanupClones() {
                        var clones = track.querySelectorAll('.home-slider-slide.is-clone');
                        clones.forEach(function (clone) {
                            clone.parentNode.removeChild(clone);
                        });
                        state.cloneCount = 0;
                    }

                    function buildClones() {
                        if (!state.loopActive || state.originalCount <= 1) {
                            state.cloneCount = 0;
                            return;
                        }
                        var count = state.originalCount;
                        state.cloneCount = count;
                        var slides = Array.prototype.slice.call(track.children);
                        slides.slice(-count).forEach(function (slide) {
                            var clone = slide.cloneNode(true);
                            clone.classList.add('is-clone');
                            track.insertBefore(clone, track.firstChild);
                        });
                        slides.slice(0, count).forEach(function (slide) {
                            var clone = slide.cloneNode(true);
                            clone.classList.add('is-clone');
                            track.appendChild(clone);
                        });
                    }

                    function updateSlideSize() {
                        var firstSlide = track.querySelector('.home-slider-slide');
                        if (!firstSlide) return;
                        var trackStyles = window.getComputedStyle(track);
                        var gap = parseFloat(trackStyles.gap || trackStyles.columnGap || '0');
                        state.slideSize = firstSlide.getBoundingClientRect().width + gap;
                    }

                    function setTranslate(value, animate) {
                        if (!animate) {
                            track.classList.add('no-transition');
                        }
                        track.style.transform = 'translate3d(' + value + 'px, 0, 0)';
                        state.currentTranslate = value;
                        if (!animate) {
                            requestAnimationFrame(function () {
                                track.classList.remove('no-transition');
                            });
                        }
                    }

                    function setTranslateImmediate(value) {
                        track.classList.add('no-transition');
                        track.style.transform = 'translate3d(' + value + 'px, 0, 0)';
                        state.currentTranslate = value;
                        void track.offsetHeight;
                        track.classList.remove('no-transition');
                    }

                    function clampIndex(index) {
                        if (loopEnabled) return index;
                        var maxIndex = Math.max(0, getTotalSlides() - Math.max(1, state.visibleCount));
                        return Math.max(0, Math.min(index, maxIndex));
                    }

                    function goTo(index, animate) {
                        state.index = clampIndex(index);
                        setTranslate(-state.index * state.slideSize, animate);
                    }

                    function next() {
                        goTo(state.index + 1, true);
                    }

                    function prev() {
                        goTo(state.index - 1, true);
                    }

                    function stopAutoplay() {
                        if (state.autoplayTimer) {
                            clearInterval(state.autoplayTimer);
                            state.autoplayTimer = null;
                        }
                    }

                    function startAutoplay() {
                        var totalSlides = getTotalSlides();
                        var autoplayAllowed = autoplayEnabled && totalSlides > 1;
                        if (!autoplayAllowed || state.autoplayTimer) return;
                        state.autoplayTimer = setInterval(function () {
                            next();
                        }, autoplayInterval);
                    }

                    function handleTransitionEnd() {
                        if (event && event.propertyName && event.propertyName !== 'transform') return;
                        if (!state.loopActive || state.cloneCount === 0) return;
                        var total = state.originalCount;
                        if (state.index >= total + state.cloneCount) {
                            state.index = state.cloneCount;
                            setTranslateImmediate(-state.index * state.slideSize);
                        } else if (state.index < state.cloneCount) {
                            state.index = total + state.cloneCount - 1;
                            setTranslateImmediate(-state.index * state.slideSize);
                        }
                    }

                    function onPointerDown(event) {
                        if (event.button && event.button !== 0) return;
                        if (window.matchMedia('(max-width: 640px)').matches) return;
                        stopAutoplay();
                        state.isDragging = true;
                        state.startX = event.clientX;
                        state.startTranslate = state.currentTranslate;
                        viewport.setPointerCapture(event.pointerId);
                        track.classList.add('is-dragging');
                    }

                    function onPointerMove(event) {
                        if (!state.isDragging) return;
                        var delta = event.clientX - state.startX;
                        setTranslate(state.startTranslate + delta, false);
                    }

                    function onPointerUp(event) {
                        if (!state.isDragging) return;
                        state.isDragging = false;
                        viewport.releasePointerCapture(event.pointerId);
                        track.classList.remove('is-dragging');
                        var delta = event.clientX - state.startX;
                        if (Math.abs(delta) > state.slideSize * 0.2) {
                            if (delta < 0) {
                                next();
                            } else {
                                prev();
                            }
                        } else {
                            goTo(state.index, true);
                        }
                        startAutoplay();
                    }

                    function setup() {
                        cleanupClones();
                        state.perView = getPerView();
                        setCssVars();
                        state.index = 0;
                        requestAnimationFrame(function () {
                            updateSlideSize();
                            state.originalCount = getTotalSlides();
                            state.visibleCount = Math.max(1, Math.floor(viewport.clientWidth / state.slideSize));
                            state.loopActive = loopEnabled && state.originalCount > 1;
                            buildClones();
                            updateSlideSize();
                            state.index = state.loopActive ? state.cloneCount : 0;
                            goTo(state.index, false);
                        });
                        if (getTotalSlides() <= 1) {
                            if (prevBtn) prevBtn.disabled = true;
                            if (nextBtn) nextBtn.disabled = true;
                            stopAutoplay();
                        }
                    }

                    setup();
                    startAutoplay();

                    if (prevBtn) prevBtn.addEventListener('click', function () {
                        stopAutoplay();
                        prev();
                        startAutoplay();
                    });
                    if (nextBtn) nextBtn.addEventListener('click', function () {
                        stopAutoplay();
                        next();
                        startAutoplay();
                    });

                    track.addEventListener('transitionend', handleTransitionEnd);
                    viewport.addEventListener('pointerdown', onPointerDown);
                    viewport.addEventListener('pointermove', onPointerMove);
                    viewport.addEventListener('pointerup', onPointerUp);
                    viewport.addEventListener('pointercancel', onPointerUp);
                    viewport.addEventListener('pointerleave', function (event) {
                        if (state.isDragging) onPointerUp(event);
                    });

                    document.addEventListener('visibilitychange', function () {
                        if (document.hidden) {
                            stopAutoplay();
                        } else {
                            startAutoplay();
                        }
                    });

                    var resizeTimer;
                    window.addEventListener('resize', function () {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(function () {
                            setup();
                        }, 120);
                    });
                });
            })();
        </script>
    {% endif %}
{% endblock %}
