{% extends 'partials/base.html.twig' %}

{% block content %}
    {% set slider = page.header.home_slider ?? {} %}
    {% set slider_items = slider.items ?? [] %}
    {% set slider_enabled = slider.enabled ?? false %}
    {% set slider_top = slider.top_content ?? '' %}
    {% set slider_bottom = slider.bottom_content ?? '' %}

    {% if slider_enabled and slider_items|length > 0 %}
        {% set slider_html %}
            <section class="home-slider home-slider--fullbleed swiper home-swiper" data-home-slider
                     data-autoplay="{{ slider.autoplay is defined and slider.autoplay ? 'true' : 'false' }}"
                     data-interval="{{ slider.interval ?? 3500 }}"
                     data-loop="{{ slider.loop is defined and slider.loop ? 'true' : 'false' }}"
                     data-per-view="5"
                     data-per-view-md="3"
                     data-per-view-sm="1.2"
                     data-gap="{{ slider.gap ?? 18 }}">
                {% if slider.title %}
                    <h2 class="home-slider-title">{{ slider.title }}</h2>
                {% endif %}
                {% if slider.description %}
                    <p class="home-slider-description">{{ slider.description }}</p>
                {% endif %}
                {% set slide_entries = [] %}
                {% set slide_urls = [] %}

                {% if slider.bulk_upload %}
                    {% for filepath, filedata in slider.bulk_upload %}
                        {% if filedata.name %}
                            {% set media = page.media[filedata.name] %}
                            {% if media and media.url not in slide_urls %}
                                {% set slide_urls = slide_urls|merge([media.url]) %}
                                {% set slide_entries = slide_entries|merge([{
                                    url: media.url,
                                    media: media,
                                    alt: '',
                                    link: ''
                                }]) %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% for item in slider_items %}
                    {% set slide_images = [] %}
                    {% if item.image_upload %}
                        {% for filepath, filedata in item.image_upload %}
                            {% if filedata.name %}
                                {% set media = page.media[filedata.name] %}
                                {% if media %}
                                    {% set slide_images = slide_images|merge([media.url]) %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if slide_images|length == 0 %}
                        {% set image_key = item.image ?? '' %}
                        {% if image_key %}
                            {% set is_external = image_key starts with 'http' %}
                            {% set media_key = is_external ? '' : image_key|split('/')|last %}
                            {% set media = media_key ? page.media[media_key] : null %}
                            {% set image_url = media ? media.url : image_key %}
                            {% if image_url %}
                                {% set slide_images = [image_url] %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                    {% if slide_images|length > 0 %}
                        {% set alt_text = item.alt ?? item.title ?? '' %}
                        {% for image_url in slide_images %}
                            {% if image_url not in slide_urls %}
                                {% set slide_urls = slide_urls|merge([image_url]) %}
                                {% set slide_entries = slide_entries|merge([{
                                    url: image_url,
                                    media: media ?? null,
                                    alt: alt_text,
                                    link: item.link ?? ''
                                }]) %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% set preload_urls = [] %}
                {% for preload in slide_entries|slice(0, 3) %}
                    {% set preload_urls = preload_urls|merge([preload.url]) %}
                {% endfor %}

                <div class="home-slider-inner" data-preload="{{ preload_urls|json_encode|e('html_attr') }}">
                    <button class="home-slider-arrow home-slider-prev swiper-button-prev" type="button" aria-label="Предыдущий слайд" data-slider-prev>
                        <span aria-hidden="true">‹</span>
                    </button>
                    <div class="home-slider-viewport" data-slider-viewport>
                        <div class="home-slider-track swiper-wrapper" data-slider-track>
                            {% for slide in slide_entries %}
                                {% set is_visible = loop.index0 < 5 %}
                                {% set is_priority = loop.index0 < 3 %}
                                <div class="home-slider-slide swiper-slide">
                                    {% if slide.link %}
                                        <a class="home-slider-card" href="{{ slide.link }}">
                                            {% if slide.media is defined and slide.media %}
                                                <img class="home-slider-image"
                                                     src="{{ slide.media.resize(350).url }}"
                                                     srcset="{{ slide.media.resize(350).url }} 350w, {{ slide.media.resize(700).url }} 700w"
                                                     sizes="(max-width: 640px) 80vw, (max-width: 960px) 30vw, 20vw"
                                                     alt="{{ slide.alt|e }}"
                                                     loading="{{ is_visible ? 'eager' : 'lazy' }}"
                                                     decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% else %}
                                                <img class="home-slider-image" src="{{ slide.url }}" alt="{{ slide.alt|e }}" loading="{{ is_visible ? 'eager' : 'lazy' }}" decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% endif %}
                                        </a>
                                    {% else %}
                                        <div class="home-slider-card">
                                            {% if slide.media is defined and slide.media %}
                                                <img class="home-slider-image"
                                                     src="{{ slide.media.resize(350).url }}"
                                                     srcset="{{ slide.media.resize(350).url }} 350w, {{ slide.media.resize(700).url }} 700w"
                                                     sizes="(max-width: 640px) 80vw, (max-width: 960px) 30vw, 20vw"
                                                     alt="{{ slide.alt|e }}"
                                                     loading="{{ is_visible ? 'eager' : 'lazy' }}"
                                                     decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% else %}
                                                <img class="home-slider-image" src="{{ slide.url }}" alt="{{ slide.alt|e }}" loading="{{ is_visible ? 'eager' : 'lazy' }}" decoding="async"{% if is_priority %} fetchpriority="high"{% endif %}>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <button class="home-slider-arrow home-slider-next swiper-button-next" type="button" aria-label="Следующий слайд" data-slider-next>
                        <span aria-hidden="true">›</span>
                    </button>
                </div>
            </section>
        {% endset %}
    {% endif %}

    {% if slider_html is defined %}
        {% if slider_top or slider_bottom %}
            {% if slider_top %}
                <div class="home-slider-text home-slider-text--top">
                    {{ slider_top|markdown|raw }}
                </div>
            {% endif %}
            {{ slider_html|raw }}
            {% if slider_bottom %}
                <div class="home-slider-text home-slider-text--bottom">
                    {{ slider_bottom|markdown|raw }}
                </div>
            {% endif %}
        {% elseif '<!-- HOME_SLIDER -->' in page.content %}
            {{ page.content|replace({'<!-- HOME_SLIDER -->': slider_html})|raw }}
        {% else %}
            {% set placement = slider.placement ?? 'before' %}
            {% if placement == 'after' %}
                {{ page.content|raw }}
                {{ slider_html|raw }}
            {% else %}
                {{ slider_html|raw }}
                {{ page.content|raw }}
            {% endif %}
        {% endif %}
    {% else %}
        {{ page.content|raw }}
    {% endif %}

    {% if slider_html is defined %}
        <script>
            (function () {
                if (window.Swiper) {
                    var swiperRoot = document.querySelector('.home-swiper');
                    if (!swiperRoot) return;
                    var preloadData = swiperRoot.querySelector('.home-slider-inner')?.dataset?.preload;
                    if (preloadData) {
                        try {
                            JSON.parse(preloadData).forEach(function (url) {
                                var img = new Image();
                                img.src = url;
                            });
                        } catch (e) {}
                    }
                    var styles = getComputedStyle(swiperRoot);
                    var gap = parseFloat(styles.getPropertyValue('--card-gap')) || 0;
                    var perView = parseFloat(styles.getPropertyValue('--slides-per-view')) || 5;
                    var autoplayEnabled = swiperRoot.dataset.autoplay === 'true';
                    var autoplayInterval = parseInt(swiperRoot.dataset.interval || '3500', 10);
                    var loopEnabled = swiperRoot.dataset.loop === 'true';

                    new Swiper(swiperRoot, {
                        slidesPerView: perView,
                        spaceBetween: gap,
                        loop: loopEnabled,
                        speed: 600,
                        watchOverflow: true,
                        navigation: {
                            nextEl: swiperRoot.querySelector('.swiper-button-next'),
                            prevEl: swiperRoot.querySelector('.swiper-button-prev')
                        },
                        autoplay: autoplayEnabled ? {
                            delay: autoplayInterval,
                            disableOnInteraction: false
                        } : false,
                        breakpoints: {
                            0: { slidesPerView: 1.2, spaceBetween: gap },
                            641: { slidesPerView: 3, spaceBetween: gap },
                            961: { slidesPerView: perView, spaceBetween: gap }
                        }
                    });
                    return;
                }

                var sliders = document.querySelectorAll('[data-home-slider]');
                if (!sliders.length) return;

                sliders.forEach(function (slider) {
                    var viewport = slider.querySelector('[data-slider-viewport]');
                    var track = slider.querySelector('[data-slider-track]');
                    var prevBtn = slider.querySelector('[data-slider-prev]');
                    var nextBtn = slider.querySelector('[data-slider-next]');
                    if (!viewport || !track) return;

                    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    var autoplayEnabled = slider.dataset.autoplay === 'true' && !reduceMotion;
                    var autoplayInterval = parseInt(slider.dataset.interval || '3500', 10);
                    var loopEnabled = slider.dataset.loop === 'true';
                    var gapValue = parseFloat(slider.dataset.gap || '18');

                    var state = {
                        perView: 1,
                        index: 0,
                        slideSize: 0,
                        visibleCount: 1,
                        cloneCount: 0,
                        originalCount: 0,
                        isDragging: false,
                        startX: 0,
                        startTranslate: 0,
                        autoplayTimer: null,
                        loopActive: false,
                        currentTranslate: 0
                    };

                    function getPerView() {
                        var width = window.innerWidth;
                        var perViewSm = parseFloat(slider.dataset.perViewSm || '1');
                        var perViewMd = parseFloat(slider.dataset.perViewMd || '2');
                        var perViewLg = parseFloat(slider.dataset.perView || '3');
                        if (width <= 640) return perViewSm;
                        if (width <= 960) return perViewMd;
                        return perViewLg;
                    }

                    function setCssVars() {
                        slider.style.setProperty('--slides-per-view', state.perView);
                        slider.style.setProperty('--slide-gap', gapValue + 'px');
                    }

                    function getTotalSlides() {
                        return track.children.length;
                    }

                    function cleanupClones() {
                        var clones = track.querySelectorAll('.home-slider-slide.is-clone');
                        clones.forEach(function (clone) {
                            clone.parentNode.removeChild(clone);
                        });
                        state.cloneCount = 0;
                    }

                    function buildClones() {
                        if (!state.loopActive || state.originalCount <= 1) {
                            state.cloneCount = 0;
                            return;
                        }
                        var count = state.originalCount;
                        state.cloneCount = count;
                        var slides = Array.prototype.slice.call(track.children);
                        slides.slice(-count).forEach(function (slide) {
                            var clone = slide.cloneNode(true);
                            clone.classList.add('is-clone');
                            track.insertBefore(clone, track.firstChild);
                        });
                        slides.slice(0, count).forEach(function (slide) {
                            var clone = slide.cloneNode(true);
                            clone.classList.add('is-clone');
                            track.appendChild(clone);
                        });
                    }

                    function updateSlideSize() {
                        var firstSlide = track.querySelector('.home-slider-slide');
                        if (!firstSlide) return;
                        var trackStyles = window.getComputedStyle(track);
                        var gap = parseFloat(trackStyles.gap || trackStyles.columnGap || '0');
                        state.slideSize = firstSlide.getBoundingClientRect().width + gap;
                    }

                    function setTranslate(value, animate) {
                        if (!animate) {
                            track.classList.add('no-transition');
                        }
                        track.style.transform = 'translate3d(' + value + 'px, 0, 0)';
                        state.currentTranslate = value;
                        if (!animate) {
                            requestAnimationFrame(function () {
                                track.classList.remove('no-transition');
                            });
                        }
                    }

                    function setTranslateImmediate(value) {
                        track.classList.add('no-transition');
                        track.style.transform = 'translate3d(' + value + 'px, 0, 0)';
                        state.currentTranslate = value;
                        void track.offsetHeight;
                        track.classList.remove('no-transition');
                    }

                    function clampIndex(index) {
                        if (loopEnabled) return index;
                        var maxIndex = Math.max(0, getTotalSlides() - Math.max(1, state.visibleCount));
                        return Math.max(0, Math.min(index, maxIndex));
                    }

                    function goTo(index, animate) {
                        state.index = clampIndex(index);
                        setTranslate(-state.index * state.slideSize, animate);
                    }

                    function next() {
                        goTo(state.index + 1, true);
                    }

                    function prev() {
                        goTo(state.index - 1, true);
                    }

                    function stopAutoplay() {
                        if (state.autoplayTimer) {
                            clearInterval(state.autoplayTimer);
                            state.autoplayTimer = null;
                        }
                    }

                    function startAutoplay() {
                        var totalSlides = getTotalSlides();
                        var autoplayAllowed = autoplayEnabled && totalSlides > 1;
                        if (!autoplayAllowed || state.autoplayTimer) return;
                        state.autoplayTimer = setInterval(function () {
                            next();
                        }, autoplayInterval);
                    }

                    function handleTransitionEnd() {
                        if (event && event.propertyName && event.propertyName !== 'transform') return;
                        if (!state.loopActive || state.cloneCount === 0) return;
                        var total = state.originalCount;
                        if (state.index >= total + state.cloneCount) {
                            state.index = state.cloneCount;
                            setTranslateImmediate(-state.index * state.slideSize);
                        } else if (state.index < state.cloneCount) {
                            state.index = total + state.cloneCount - 1;
                            setTranslateImmediate(-state.index * state.slideSize);
                        }
                    }

                    function onPointerDown(event) {
                        if (event.button && event.button !== 0) return;
                        stopAutoplay();
                        state.isDragging = true;
                        state.startX = event.clientX;
                        state.startTranslate = state.currentTranslate;
                        viewport.setPointerCapture(event.pointerId);
                        track.classList.add('is-dragging');
                    }

                    function onPointerMove(event) {
                        if (!state.isDragging) return;
                        var delta = event.clientX - state.startX;
                        setTranslate(state.startTranslate + delta, false);
                    }

                    function onPointerUp(event) {
                        if (!state.isDragging) return;
                        state.isDragging = false;
                        viewport.releasePointerCapture(event.pointerId);
                        track.classList.remove('is-dragging');
                        var delta = event.clientX - state.startX;
                        if (Math.abs(delta) > state.slideSize * 0.2) {
                            if (delta < 0) {
                                next();
                            } else {
                                prev();
                            }
                        } else {
                            goTo(state.index, true);
                        }
                        startAutoplay();
                    }

                    function setup() {
                        cleanupClones();
                        state.perView = getPerView();
                        setCssVars();
                        state.index = 0;
                        requestAnimationFrame(function () {
                            updateSlideSize();
                            state.originalCount = getTotalSlides();
                            state.visibleCount = Math.max(1, Math.floor(viewport.clientWidth / state.slideSize));
                            state.loopActive = loopEnabled && state.originalCount > 1;
                            buildClones();
                            updateSlideSize();
                            state.index = state.loopActive ? state.cloneCount : 0;
                            goTo(state.index, false);
                        });
                        if (getTotalSlides() <= 1) {
                            if (prevBtn) prevBtn.disabled = true;
                            if (nextBtn) nextBtn.disabled = true;
                            stopAutoplay();
                        }
                    }

                    setup();
                    startAutoplay();

                    if (prevBtn) prevBtn.addEventListener('click', function () {
                        stopAutoplay();
                        prev();
                        startAutoplay();
                    });
                    if (nextBtn) nextBtn.addEventListener('click', function () {
                        stopAutoplay();
                        next();
                        startAutoplay();
                    });

                    track.addEventListener('transitionend', handleTransitionEnd);
                    viewport.addEventListener('pointerdown', onPointerDown);
                    viewport.addEventListener('pointermove', onPointerMove);
                    viewport.addEventListener('pointerup', onPointerUp);
                    viewport.addEventListener('pointercancel', onPointerUp);
                    viewport.addEventListener('pointerleave', function (event) {
                        if (state.isDragging) onPointerUp(event);
                    });

                    document.addEventListener('visibilitychange', function () {
                        if (document.hidden) {
                            stopAutoplay();
                        } else {
                            startAutoplay();
                        }
                    });

                    var resizeTimer;
                    window.addEventListener('resize', function () {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(function () {
                            setup();
                        }, 120);
                    });
                });
            })();
        </script>
    {% endif %}
{% endblock %}
