
# Runtime directories (regenerated on each request)
cache/
logs/
tmp/
backup/
assets/

# Composer dependencies (regenerate with: composer install)
vendor/
composer.phar

# User data (sensitive - accounts, form submissions, etc.)
user/accounts/
user/data/

# Sensitive config: use *.example files; keep real values local or in env
user/config/security.yaml
user/config/plugins/email.yaml
user/plugins/email.yaml

# Archive files (backups, exports, etc.)
*.zip
*.tar
*.tar.gz
*.gz
*.rar
*.7z

